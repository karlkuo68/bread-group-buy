#!/bin/bash
cd "$(dirname "$0")"
rm -f .git/HEAD.lock .git/index.lock .git/objects/*/tmp_obj_* 2>/dev/null
git add index.html logo.png 2>/dev/null
git diff --cached --quiet && echo "（沒有新改動）" || git commit -m "fix(units): 品項名稱 normalize 加入同音字 alias（鬆/頌、菠/波、土/吐、餐麵包/餐包、歐式麵包/歐包）"
git push origin main
echo ""
echo "=========================================="
echo "推完了！1-2 分鐘後到線上強制刷新（Cmd+Shift+R）"
echo "=========================================="
sleep 5
